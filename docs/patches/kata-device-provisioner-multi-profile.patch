diff --git a/deploy/helm/kata-device-provisioner/templates/_helpers.tpl b/deploy/helm/kata-device-provisioner/templates/_helpers.tpl
index 037939e..4515a7a 100644
--- a/deploy/helm/kata-device-provisioner/templates/_helpers.tpl
+++ b/deploy/helm/kata-device-provisioner/templates/_helpers.tpl
@@ -5,6 +5,88 @@ Common labels.
 app.kubernetes.io/name: {{ .Chart.Name }}
 app.kubernetes.io/instance: {{ .Release.Name }}
 app.kubernetes.io/managed-by: {{ .Release.Service }}
+{{- with .profileName }}
+kata-device-provisioner.katacontainers.io/profile: {{ include "kata-device-provisioner.profileSlug" $ | quote }}
+{{- end }}
+{{- end -}}
+
+{{/*
+Turn a profile map key into a DNS label. Keep a hash when truncating so two
+long profile names with the same prefix cannot select each other's resources.
+*/}}
+{{- define "kata-device-provisioner.profileSlug" -}}
+{{- $raw := .profileName | toString -}}
+{{- $slug := regexReplaceAll "[^a-z0-9-]+" (lower $raw) "-" | trimAll "-" -}}
+{{- if not $slug -}}
+{{- $slug = "profile" -}}
+{{- end -}}
+{{- if or (ne $slug $raw) (gt (len $slug) 63) -}}
+{{- printf "%s-%s" ($slug | trunc 54 | trimSuffix "-") (sha256sum $raw | trunc 8) -}}
+{{- else -}}
+{{- $slug -}}
+{{- end -}}
+{{- end -}}
+
+{{/*
+Name a profile-scoped resource. The final hash protects names whose
+chart/profile/suffix combination exceeds 63 bytes.
+*/}}
+{{- define "kata-device-provisioner.profileResourceName" -}}
+{{- $name := printf "%s-%s-%s" .root.Chart.Name (include "kata-device-provisioner.profileSlug" .root) .suffix -}}
+{{- if gt (len $name) 63 -}}
+{{- printf "%s-%s" ($name | trunc 54 | trimSuffix "-") (sha256sum $name | trunc 8) -}}
+{{- else -}}
+{{- $name -}}
+{{- end -}}
+{{- end -}}
+
+{{/*
+Render a named template once for each enabled profile. Profile fields override
+shared chart defaults directly. profiles and enabled are removed from each
+effective Values map so they cannot become operational settings.
+*/}}
+{{- define "kata-device-provisioner.renderProfiles" -}}
+{{- $root := .root -}}
+{{- $renderer := .renderer -}}
+{{- $profiles := $root.Values.profiles | default dict -}}
+{{- range $name, $profile := $profiles -}}
+{{- if or (hasKey $profile "profile") (hasKey $profile "cpuTee") (hasKey $profile "values") -}}
+{{- fail (printf "profiles.%s: profile, cpuTee, and values metadata fields are not supported; the map key is the identity and operational fields belong directly in the profile" $name) -}}
+{{- end -}}
+{{- if $profile.enabled -}}
+{{- $defaults := deepCopy $root.Values -}}
+{{- $_ := unset $defaults "profiles" -}}
+{{- $profileDefaults := dict "ccModeOverrides" (list) "ccModeLabel" "nvidia.com/cc.mode" "ccModeReadyLabel" "nvidia.com/cc.ready.state" "nodeSelector" (dict) "nodeSelectorExpressions" (list) -}}
+{{- $overrides := deepCopy $profile -}}
+{{- $_ := unset $overrides "enabled" -}}
+{{- $values := mergeOverwrite $defaults $profileDefaults $overrides -}}
+{{- $profileRoot := dict "Chart" $root.Chart "Release" $root.Release "Capabilities" $root.Capabilities "Files" $root.Files "Template" $root.Template "Values" $values "profileName" $name -}}
+{{- if not (hasKey $profile "ccModeStateLabel") -}}
+{{- $slug := include "kata-device-provisioner.profileSlug" $profileRoot -}}
+{{- $stateSegment := printf "%s-%s-state" ($slug | trunc 47 | trimSuffix "-") (sha256sum ($name | toString) | trunc 8) -}}
+{{- $_ := set $values "ccModeStateLabel" (printf "kata-device-provisioner.katacontainers.io/%s" $stateSegment) -}}
+{{- end -}}
+{{ include $renderer $profileRoot }}
+{{- end -}}
+{{- end -}}
+{{- end -}}
+
+{{/*
+Non-empty when at least one profile is enabled. Shared RBAC is useful only when
+a dispatcher can be rendered; an empty profile map is therefore a clean no-op.
+*/}}
+{{- define "kata-device-provisioner.hasEnabledProfiles" -}}
+{{- range $profile := (.Values.profiles | default dict) -}}
+{{- if $profile.enabled }}true{{ end -}}
+{{- end -}}
+{{- end -}}
+
+{{/*
+Short, unique prefix for Jobs created dynamically by a profile dispatcher.
+*/}}
+{{- define "kata-device-provisioner.profileJobPrefix" -}}
+{{- $slug := include "kata-device-provisioner.profileSlug" .root -}}
+{{- printf "%s-%s-%s" .profilePrefix ($slug | trunc 6 | trimSuffix "-") (sha256sum (.root.profileName | toString) | trunc 6) -}}
 {{- end -}}
 
