{
  "name": "krab",
  "private": true,
  "version": "0.2.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate": "tsx scripts/sync-upstream.ts",
    "sync:upstream": "tsx scripts/sync-upstream.ts --fetch",
    "verify:precheck-image": "tsx scripts/verify-precheck-image.ts",
    "verify:erofs-image": "tsx scripts/verify-erofs-image.ts",
    "refresh:erofs-image": "tsx scripts/refresh-erofs-image.ts",
    "refresh:nfd": "tsx scripts/refresh-upstream.ts --group nfd",
    "refresh:upstream": "tsx scripts/refresh-upstream.ts",
    "verify:chart-artifact": "tsx scripts/verify-chart-artifact.ts",
    "test": "tsx --test test/*.test.ts",
    "test:cli-parity": "tsx scripts/check-cli-parity.ts",
    "test:chart": "tsx --test test/chart.test.ts",
    "test:helm": "tsx --test test/helm-render.ts test/helm-nvidia-cpu-cc.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:core": "python3 scripts/build-core.py",
    "prebuild": "node scripts/verify-core.mjs",
    "pretest": "node scripts/verify-core.mjs",
    "pretest:cli-parity": "node scripts/verify-core.mjs",
    "predev": "node scripts/verify-core.mjs"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
